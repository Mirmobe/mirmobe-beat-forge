{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mirmobe.github.io/mirmobe-beat-forge/addons/schema.json",
  "title": "Mirmobe Beat Forge add-ons",
  "description": "JSON shapes for the registry, a module manifest, and a runtime pack. Executable add-ons are ES modules dropped into the repo. Runtime imports accept JSON packs only.",
  "oneOf": [
    { "$ref": "#/definitions/registry" },
    { "$ref": "#/definitions/pack" }
  ],
  "definitions": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "addons"],
      "properties": {
        "format": { "const": "mirmobe-beat-forge-registry" },
        "version": { "type": "integer", "minimum": 1 },
        "addons": {
          "type": "array",
          "items": { "$ref": "#/definitions/moduleManifest" }
        }
      }
    },
    "moduleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "entry", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "const": "module" },
        "entry": { "type": "string", "description": "ES module path relative to addons/registry.json, for example ./my-addon.js" },
        "builtin": { "type": "boolean" },
        "defaultEnabled": { "type": "boolean" }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "addons"],
      "properties": {
        "format": { "const": "mirmobe-beat-forge-pack" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "addons": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/presetPack" },
              { "$ref": "#/definitions/vocalChains" },
              { "$ref": "#/definitions/lyricSeeds" }
            ]
          }
        }
      }
    },
    "presetPack": {
      "type": "object",
      "required": ["id", "name", "kind", "presets"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "const": "preset-pack" },
        "presets": {
          "type": "array",
          "items": { "$ref": "#/definitions/preset" }
        }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "patterns"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bpm": { "type": "number", "minimum": 60, "maximum": 180 },
        "swing": { "type": "number", "minimum": 0, "maximum": 0.45 },
        "key": { "type": "string" },
        "scale": { "enum": ["minor", "major", "dorian", "pentatonic"] },
        "steps": { "enum": [16, 32] },
        "sidechain": { "type": "number", "minimum": 0, "maximum": 1 },
        "patterns": { "$ref": "#/definitions/pattern" },
        "voice": { "type": "object" }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["kick", "snare", "clap", "hat", "openhat", "perc", "bass", "chords"],
      "properties": {
        "kick": { "$ref": "#/definitions/drumLine" },
        "snare": { "$ref": "#/definitions/drumLine" },
        "clap": { "$ref": "#/definitions/drumLine" },
        "hat": { "$ref": "#/definitions/drumLine" },
        "openhat": { "$ref": "#/definitions/drumLine" },
        "perc": { "$ref": "#/definitions/drumLine" },
        "bass": { "$ref": "#/definitions/degreeLine" },
        "chords": { "$ref": "#/definitions/degreeLine" }
      }
    },
    "drumLine": {
      "type": "array",
      "minItems": 16,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 1 }
    },
    "degreeLine": {
      "type": "array",
      "minItems": 16,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 7, "description": "0 is a rest. 1-7 are scale degrees." }
    },
    "vocalChains": {
      "type": "object",
      "required": ["id", "name", "kind", "chains"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "const": "vocal-chains" },
        "chains": {
          "type": "array",
          "items": { "$ref": "#/definitions/vocalChain" }
        }
      }
    },
    "vocalChain": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "eqLow": { "type": "number", "minimum": -12, "maximum": 12 },
        "eqMid": { "type": "number", "minimum": -12, "maximum": 12 },
        "eqHigh": { "type": "number", "minimum": -12, "maximum": 12 },
        "reverb": { "type": "number", "minimum": 0, "maximum": 1 },
        "delay": { "type": "number", "minimum": 0, "maximum": 1 },
        "drive": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "lyricSeeds": {
      "type": "object",
      "required": ["id", "kind", "lines"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "const": "lyric-seeds" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
